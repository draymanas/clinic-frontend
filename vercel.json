{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://clinic-api-ig3d.onrender.com/sitemap.xml"
    },
    {
      "source": "/d/:slugOrId*",
      "destination": "https://clinic-api-ig3d.onrender.com/d/:slugOrId*"
    },
    {
      "source": "/service/:serviceId*",
      "destination": "https://clinic-api-ig3d.onrender.com/service/:serviceId*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}