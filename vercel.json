{
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://clinic-api-ig3d.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-doctors.xml",
      "destination": "https://clinic-api-ig3d.onrender.com/sitemap-doctors.xml"
    },
    {
      "source": "/sitemap-categories.xml",
      "destination": "https://clinic-api-ig3d.onrender.com/sitemap-categories.xml"
    },
    {
      "source": "/sitemap-services.xml",
      "destination": "https://clinic-api-ig3d.onrender.com/sitemap-services.xml"
    },
    {
      "source": "/d/:slugOrId*",
      "destination": "https://clinic-api-ig3d.onrender.com/d/:slugOrId*"
    },
    {
      "source": "/s/:serviceId*",
      "destination": "https://clinic-api-ig3d.onrender.com/s/:serviceId*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}